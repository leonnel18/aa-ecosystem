# ============================================================
# aa-ecosystem — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# Zoho CRM — OAuth 2.0
# Get client credentials from: https://api-console.zoho.com/
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=
ZOHO_CRM_REFRESH_TOKEN=
ZOHO_CRM_REDIRECT_URI=https://www.zoho.com/crm/developer/redirect
ZOHO_CRM_REGION=COM
# Regions: COM | IN | EU | AU | JP | CN

# Zoho Analytics — OAuth 2.0 (optional audit layer, separate client)
ZOHO_ANALYTICS_CLIENT_ID=
ZOHO_ANALYTICS_CLIENT_SECRET=
ZOHO_ANALYTICS_REFRESH_TOKEN=
ZOHO_ANALYTICS_WORKSPACE_ID=
ZOHO_ANALYTICS_ORG_ID=
ZOHO_ANALYTICS_EMAIL=

# CRM Module API Names
# These are confirmed Zoho API names — do not change without updating SOPs
CRM_MODULE_APPLICATIONS=Deals
CRM_MODULE_ORGANIZATIONS=Accounts
CRM_MODULE_TRAININGS=Solutions
CRM_MODULE_TRAINING_TYPES=Products
CRM_MODULE_PRACTICE_SESSIONS=Forms
CRM_MODULE_SESSION_PARTICIPANTS=Skill_Session_Participant

# Pipeline Config
PORTALS=PK,PH,KR,ID,backbone
DATE_RANGE_DAYS=730
